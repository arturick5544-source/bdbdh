    -- ═══════ ЗАПУСК РАДУЖНОЙ АНИМАЦИИ ═══════
    local rainbowObjects = {
        menuFrame,
        header,
        closeBtn,
        squareBtn,
        toggleBtn,
        distBtn,
        colorBtn
    }
    StartRainbow(rainbowObjects)
    
    -- ═══════ F1 — переключение ═══════
    UserInput.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == Enum.KeyCode.F1 then
            if menuFrame.Visible then
                menuFrame.Visible = false
                if squareBtn then
                    squareBtn.Visible = true
                    squareBtn.Size = UDim2.new(0, 0, 0, 0)
                    squareBtn:TweenSize(UDim2.new(0, 50, 0, 50), "Out", "Quad", 0.3, true)
                end
            else
                if squareBtn then
                    squareBtn.Visible = false
                end
                menuFrame.Visible = true
                menuFrame.Size = UDim2.new(0, 0, 0, 0)
                menuFrame:TweenSize(UDim2.new(0, 190, 0, 210), "Out", "Elastic", 0.5, true)
            end
