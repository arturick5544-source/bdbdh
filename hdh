local CONFIG = {
    Enabled = true,
    MaxDist = 500,
    OutlineColor = Color3.fromRGB(255, 255, 255),
    FillColor = Color3.fromRGB(0, 255, 200),
    FillTransparency = 0.7,
    OutlineTransparency = 0.1
}

-- ═══════════════════════════════════════════════════════════════════
-- ПЕРЕМЕННЫЕ
-- ═══════════════════════════════════════════════════════════════════
local ESPFolder = Instance.new("Folder")
ESPFolder.Name = "UltraESP"
ESPFolder.Parent = CoreGui

local espData = {}
local squareBtn = nil
local menuFrame = nil
local menuGui = nil
local rainbowThread = nil

-- ═══════════════════════════════════════════════════════════════════
-- РАДУЖНАЯ АНИМАЦИЯ
-- ═══════════════════════════════════════════════════════════════════
local function RainbowColor(t)
    local r = math.sin(t) * 0.5 + 0.5
    local g = math.sin(t + 2.094) * 0.5 + 0.5
    local b = math.sin(t + 4.188) * 0.5 + 0.5
    return Color3.new(r, g, b)
end

local function StartRainbow(objects)
    if rainbowThread then
        rainbowThread = nil
    end
    rainbowThread = spawn(function()
        local t = 0
        while rainbowThread do
            t = t + 0.03
            local color = RainbowColor(t)
            for _, obj in pairs(objects) do
                if obj and obj.Parent then
                    obj.BorderColor3 = color
                end
            end
            task.wait(0.05)
        end
    end)
end

-- ═══════════════════════════════════════════════════════════════════
-- СОЗДАНИЕ ОБВОДКИ (Highlight)
-- ═══════════════════════════════════════════════════════════════════
local function CreateHighlight(player)
    if player == LocalPlayer then return end
    if espData[player] then return end
    
    local char = player.Character
    if not char then return end
    
    local highlight = Instance.new("Highlight")
    highlight.Name = "PlayerHighlight"
    highlight.Adornee = char
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Enabled = true
    highlight.FillColor = CONFIG.FillColor
    highlight.FillTransparency = CONFIG.FillTransparency
    highlight.OutlineColor = CONFIG.OutlineColor
    highlight.OutlineTransparency = CONFIG.OutlineTransparency
    highlight.Parent = ESPFolder
    
    espData[player] = {
        Highlight = highlight,
        Character = char,
        IsDead = false
    }
end

-- ═══════════════════════════════════════════════════════════════════
-- ОБНОВЛЕНИЕ ОБВОДКИ
-- ═══════════════════════════════════════════════════════════════════
local function UpdateESP()
    if not CONFIG.Enabled then
        for _, data in pairs(espData) do
            if data.Highlight then
                data.Highlight.Enabled = false
            end
        end
        return
    end
    
    local camPos = Camera.CFrame.Position
    
    for player, data in pairs(espData) do
        if not data.Highlight or not data.Highlight.Parent then
            espData[player] = nil
            break
        end
        
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChild("Humanoid")
        
        if not char or not hrp or not humanoid or humanoid.Health <= 0 then
            data.IsDead = true
            data.Highlight.Enabled = false
            continue
        end
        
        data.IsDead = false
        
        if data.Highlight.Adornee ~= char then
            data.Highlight.Adornee = char
        end
        
        local dist = (hrp.Position - camPos).Magnitude
        
        if dist <= CONFIG.MaxDist then
            data.Highlight.Enabled = true
        else
            data.Highlight.Enabled = false
        end
        
        if humanoid and humanoid.Health < 30 then
            data.Highlight.FillColor = Color3.fromRGB(255, 0, 0)
            data.Highlight.OutlineColor = Color3.fromRGB(255, 200, 0)
            data.Highlight.FillTransparency = 0.3 + 0.3 * math.sin(os.clock() * 4)
        else
            data.Highlight.FillColor = CONFIG.FillColor
            data.Highlight.OutlineColor = CONFIG.OutlineColor
            data.Highlight.FillTransparency = CONFIG.FillTransparency
        end
    end
end

