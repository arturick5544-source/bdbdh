local function ShowDamageNotification(player, damage, isHeal)
    if isHeal and not _G.STARS_CONFIG.Damage.ShowHeal then return end
    if not isHeal and not _G.STARS_CONFIG.Damage.ShowDamage then return end

    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end

    local screenPos, onScreen = Camera:WorldToScreenPoint(char.HumanoidRootPart.Position)
    if not onScreen then return end

    local label = Instance.new("TextLabel")
    label.Text = (isHeal and "+" or "-") .. math.abs(damage)
    label.TextColor3 = isHeal and _G.STARS_CONFIG.Damage.HealColor or _G.STARS_CONFIG.Damage.DamageColor
    label.TextScaled = true
    label.Font = Enum.Font.GothamBold
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(0, 120, 0, 50)
    label.Position = UDim2.new(0, screenPos.X - 60, 0, screenPos.Y - 60)
    label.Parent = CoreGui

    -- Анимация
    TweenService:Create(label, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Position = UDim2.new(0, screenPos.X - 60, 0, screenPos.Y - 180),
        TextTransparency = 1
    }):Play()

    task.wait(1.2)
    label:Destroy()
end

local function ShowKillAnnouncement(player)
    local label = Instance.new("TextLabel")
    label.Text = "☠ " .. player.Name .. " УБИТ! ☠"
    label.TextColor3 = _G.STARS_CONFIG.Damage.KillColor
    label.TextScaled = true
    label.Font = Enum.Font.GothamBold
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(0, 300, 0, 40)
    label.Position = UDim2.new(0.5, -150, 0.2, 0)
    label.Parent = CoreGui

    -- Анимация
    TweenService:Create(label, TweenInfo.new(1.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Position = UDim2.new(0.5, -150, 0.1, 0),
        TextTransparency = 1
    }):Play()

    task.wait(1.5)
    label:Destroy()
end

