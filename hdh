    openBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    openBtn.BackgroundTransparency = 0.2
    openBtn.Text = "🔪"
    openBtn.TextColor3 = Color3.new(1, 1, 1)
    openBtn.TextScaled = true
    openBtn.Font = Enum.Font.GothamBold
    openBtn.Visible = false
    openBtn.Parent = menuGui
    openBtn.MouseButton1Click:Connect(function()
        frame.Visible = true
        openBtn.Visible = false
        MenuOpen = true
    end)
    
    -- Кнопка Вкл/Выкл
    local toggle = Instance.new("TextButton")
    toggle.Size = UDim2.new(0.8, 0, 0, 35)
    toggle.Position = UDim2.new(0.1, 0, 0.4, 0)
    toggle.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
    toggle.Text = "ВЫКЛЮЧИТЬ"
    toggle.TextColor3 = Color3.new(1, 1, 1)
    toggle.TextScaled = true
    toggle.Font = Enum.Font.GothamBold
    toggle.Parent = frame
    toggle.MouseButton1Click:Connect(function()
        CONFIG.Enabled = not CONFIG.Enabled
        toggle.Text = CONFIG.Enabled and "ВЫКЛЮЧИТЬ" or "ВКЛЮЧИТЬ"
        toggle.BackgroundColor3 = CONFIG.Enabled and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(150, 0, 0)
        for _, data in pairs(espData) do
            if data.Highlight then
                data.Highlight.Enabled = CONFIG.Enabled
            end
            if data.Billboard then
                data.Billboard.Enabled = CONFIG.Enabled
            end
        end
    end)
    
    -- Информация о ролях
    local infoFrame = Instance.new("Frame")
    infoFrame.Size = UDim2.new(0.9, 0, 0, 30)
    infoFrame.Position = UDim2.new(0.05, 0, 0.7, 0)
    infoFrame.BackgroundTransparency = 1
    infoFrame.Parent = frame
    
    local roles = {
        {text = "🔴 Убийца", color = Color3.fromRGB(255, 0, 0)},
        {text = "🔵 Шериф", color = Color3.fromRGB(0, 150, 255)},
        {text = "🟢 Мирный", color = Color3.fromRGB(0, 255, 100)}
    }
    
    for i, role in ipairs(roles) do
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(0.3, 0, 1, 0)
        label.Position = UDim2.new((i-1) * 0.34, 0, 0, 0)
        label.BackgroundTransparency = 1
        label.Text = role.text
        label.TextColor3 = role.color
        label.TextScaled = true
        label.Font = Enum.Font.Gotham
        label.Parent = infoFrame
    end
    
    -- Кнопка перезапуска
    local resetBtn = Instance.new("TextButton")
    resetBtn.Size = UDim2.new(0.3, 0, 0, 30)
    resetBtn.Position = UDim2.new(0.7, 0, 0.4, 0)
    resetBtn.BackgroundColor3 = Color3.fromRGB(200, 100, 0)
    resetBtn.Text = "🔄"
    resetBtn.TextColor3 = Color3.new(1, 1, 1)
    resetBtn.TextScaled = true
    resetBtn.Font = Enum.Font.GothamBold
    resetBtn.Parent = frame
    resetBtn.MouseButton1Click:Connect(function()
        ESPFolder:Destroy()
        menuGui:Destroy()
        print("🔄 Перезапуск...")
        task.wait(0.5)
        loadstring(game:HttpGet("https://pastebin.com/raw/YOUR_CODE", true))()
    end)
    
    -- Горячая клавиша F1
    UserInput.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == Enum.KeyCode.F1 then
            frame.Visible = not frame.Visible
            openBtn.Visible = not frame.Visible
            MenuOpen = frame.Visible
        end
    end)
    
    return frame, openBtn
end

