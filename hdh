-- СОЗДАНИЕ ОБВОДКИ (Highlight)
-- ═══════════════════════════════════════════════════════════════════
local function CreateHighlight(player)
    if player == LocalPlayer then return end
    if espData[player] then return end
    
    local char = player.Character
    if not char then return end
    
    local highlight = Instance.new("Highlight")
    highlight.Name = "PlayerHighlight"
    highlight.Adornee = char
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Enabled = true
    highlight.FillColor = CONFIG.FillColor
    highlight.FillTransparency = CONFIG.FillTransparency
    highlight.OutlineColor = CONFIG.OutlineColor
    highlight.OutlineTransparency = CONFIG.OutlineTransparency
    highlight.Parent = ESPFolder
    
    espData[player] = {
        Highlight = highlight,
        Character = char,
        IsDead = false
    }
end

-- ═══════════════════════════════════════════════════════════════════
-- ОБНОВЛЕНИЕ ОБВОДКИ
-- ═══════════════════════════════════════════════════════════════════
local function UpdateESP()
    if not CONFIG.Enabled then
        for _, data in pairs(espData) do
            if data.Highlight then
                data.Highlight.Enabled = false
            end
        end
        return
    end
    
    local camPos = Camera.CFrame.Position
    
    for player, data in pairs(espData) do
        if not data.Highlight or not data.Highlight.Parent then
            espData[player] = nil
            break
        end
        
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChild("Humanoid")
        
        if not char or not hrp or not humanoid or humanoid.Health <= 0 then
            data.IsDead = true
            data.Highlight.Enabled = false
            continue
        end
        
        data.IsDead = false
        
        if data.Highlight.Adornee ~= char then
            data.Highlight.Adornee = char
        end
        
        local dist = (hrp.Position - camPos).Magnitude
        
        if dist <= CONFIG.MaxDist then
            data.Highlight.Enabled = true
        else
            data.Highlight.Enabled = false
        end
        
        if humanoid and humanoid.Health < 30 then
            data.Highlight.FillColor = Color3.fromRGB(255, 0, 0)
            data.Highlight.OutlineColor = Color3.fromRGB(255, 200, 0)
            data.Highlight.FillTransparency = 0.3 + 0.3 * math.sin(os.clock() * 4)
        else
            data.Highlight.FillColor = CONFIG.FillColor
            data.Highlight.OutlineColor = CONFIG.OutlineColor
            data.Highlight.FillTransparency = CONFIG.FillTransparency
        end
    end
end

-- ═══════════════════════════════════════════════════════════════════
-- МУЗЫКАЛЬНАЯ СИСТЕМА (ИСПРАВЛЕННАЯ)
-- ═══════════════════════════════════════════════════════════════════
local function GetSoundName(id)
    local success, result = pcall(function()
        local url = "https://api.roblox.com/assets/" .. id .. "/info"
        local response = game:HttpGet(url)
        local data = HttpService:JSONDecode(response)
        return data.Name or "Неизвестно"
    end)
    if success and result then
        return result
    end
    return "Неизвестно (ID: " .. id .. ")"
end

local function PlayMusicForAll(songId)
    if not songId or songId == "" then return end
    
    -- Останавливаем предыдущую музыку
    if currentSound then
        currentSound:Stop()
        currentSound:Destroy()
        currentSound = nil
    end
    if soundPart then
        soundPart:Destroy()
        soundPart = nil
    end
    
    -- Создаём Part в workspace (чтобы звук был в мире)
    soundPart = Instance.new("Part")
    soundPart.Name = "MusicPlayer"
    soundPart.Size = Vector3.new(1, 1, 1)
    soundPart.Anchored = true
    soundPart.CanCollide = false
    soundPart.Transparency = 1
    soundPart.Position = Vector3.new(0, 999, 0) -- Высоко в небе, чтобы не мешал
    soundPart.Parent = workspace
    
    -- Создаём звук
    currentSound = Instance.new("Sound")
    currentSound.SoundId = "rbxassetid://" .. songId
    currentSound.Volume = 1
    currentSound.Pitch = 1
    currentSound.Looped = true
    currentSound.MaxDistance = 1000
    currentSound.Parent = soundPart
    
    -- ВАЖНО: включаем звук
    currentSound:Play()
    
    -- Получаем название
    soundName = GetSoundName(songId)
    
    print("🎵 Сейчас играет: " .. soundName)
    print("🎵 ID: " .. songId)
    print("🎵 Громкость: " .. currentSound.Volume)
    print("🎵 Все игроки слышат!")
end

