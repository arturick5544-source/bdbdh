-- ═══════════════════════════════════════════════════════════════════
-- ОПРЕДЕЛЕНИЕ РОЛИ В MM2 (РАСШИРЕННОЕ)
-- ═══════════════════════════════════════════════════════════════════
local function GetPlayerRole(player)
    if not player or player == LocalPlayer then return "Innocent" end
    
    local character = player.Character
    if not character then return "Innocent" end
    
    -- 1. ПРОВЕРКА ЧЕРЕЗ ИНСТРУМЕНТЫ (самый надёжный способ)
    local tool = player:FindFirstChildOfClass("Tool")
    if tool then
        local toolName = tool.Name:lower()
        if toolName:find("knife") or toolName:find("dagger") or toolName:find("murder") or toolName:find("blade") then
            return "Murderer"
        end
        if toolName:find("gun") or toolName:find("pistol") or toolName:find("sheriff") or toolName:find("revolver") then
            return "Sheriff"
        end
    end
    
    -- 2. ПРОВЕРКА ЧЕРЕЗ ШЛЯПЫ (для старых версий)
    local hat = character:FindFirstChild("Hat")
    if hat then
        local hatName = hat.Name:lower()
        if hatName:find("knife") or hatName:find("murder") or hatName:find("killer") then
            return "Murderer"
        end
        if hatName:find("sheriff") or hatName:find("detective") or hatName:find("badge") then
            return "Sheriff"
        end
    end
    
    -- 3. ПРОВЕРКА ЧЕРЕЗ ACCESSORY
    for _, accessory in pairs(character:GetChildren()) do
        if accessory:IsA("Accessory") then
            local accName = accessory.Name:lower()
            if accName:find("knife") or accName:find("murder") or accName:find("killer") then
                return "Murderer"
            end
            if accName:find("sheriff") or accName:find("detective") or accName:find("badge") or accName:find("gun") then
                return "Sheriff"
            end
        end
    end
    
    -- 4. ПРОВЕРКА ЧЕРЕЗ ИМЯ (запасной вариант)
    local nameLower = player.Name:lower()
    if nameLower:find("murder") or nameLower:find("killer") or nameLower:find("knife") then
        return "Murderer"
    end
    if nameLower:find("sheriff") or nameLower:find("detective") or nameLower:find("gun") then
        return "Sheriff"
    end
    
    return "Innocent"
end

-- ═══════════════════════════════════════════════════════════════════
-- ПОЛУЧЕНИЕ ЦВЕТА РОЛИ
-- ═══════════════════════════════════════════════════════════════════
local function GetRoleColor(role)
    return CONFIG.Roles[role] or CONFIG.Roles.Innocent
end

local function GetRoleIcon(role)
    return CONFIG.RoleIcons[role] or "👤"
end

-- ═══════════════════════════════════════════════════════════════════
-- СОЗДАНИЕ ESP ДЛЯ ИГРОКА (ПОЛНАЯ ВЕРСИЯ)
-- ═══════════════════════════════════════════════════════════════════
local function CreateESP(player)
    if player == LocalPlayer then return end
    if espData[player] then
        -- Если уже есть, просто обновляем
        return
    end
    
    local role = GetPlayerRole(player)
    local roleColor = GetRoleColor(role)
    local roleIcon = GetRoleIcon(role)
    
    -- ═══════ ОСНОВНАЯ ПАПКА ═══════
    local playerFolder = Instance.new("Folder")
    playerFolder.Name = player.Name
    playerFolder.Parent = ESPFolder
    
    -- ═══════ ПОДСВЕТКА (Highlight) ═══════
    local highlight = Instance.new("Highlight")
    highlight.Name = "Highlight"
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Enabled = true
    highlight.FillColor = roleColor
    highlight.FillTransparency = 0.6
    highlight.OutlineColor = CONFIG.OutlineColor  -- БЕЛАЯ ОБВОДКА
    highlight.OutlineTransparency = 0.05
    highlight.Parent = playerFolder
    
    -- ═══════ БИЛЛБОРД С ИМЕНЕМ ═══════
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "NameTag"
    billboard.AlwaysOnTop = true
    billboard.Size = UDim2.new(0, 300, 0, 60)
    billboard.StudsOffset = Vector3.new(0, 3.8, 0)
    billboard.MaxDistance = CONFIG.MaxDist
    billboard.Parent = playerFolder
    
    -- ФОН ИМЕНИ (полупрозрачный)
    local bg = Instance.new("Frame")
    bg.Size = UDim2.new(1, 0, 1, 0)
    bg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    bg.BackgroundTransparency = 0.4
    bg.BorderSizePixel = 2
    bg.BorderColor3 = CONFIG.OutlineColor
    bg.Parent = billboard
    
    -- САМ ТЕКСТ (имя + иконка)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = roleColor
    label.TextScaled = true
    label.Font = CONFIG.Font
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.TextStrokeTransparency = 0.2
    label.Text = roleIcon .. " " .. player.Name
    label.Parent = billboard
    
    -- ═══════ 3D БОКС (для наглядности) ═══════
    local box = Instance.new("BoxHandleAdornment")
    box.Size = Vector3.new(3.5, 5.5, 1.5)
    box.AlwaysOnTop = true
    box.ZIndex = 10
    box.Color3 = roleColor
    box.Transparency = 0.5
    box.Visible = false
    box.Parent = playerFolder
    
    -- ═══════ СОХРАНЯЕМ ДАННЫЕ ═══════
    espData[player] = {
        Folder = playerFolder,
        Highlight = highlight,
        Billboard = billboard,
        Label = label,
        Box = box,
        Role = role,
        LastRole = role,
        Character = player.Character,
        IsDead = false,
        LastHealth = 100
    }
    
    -- Привязываем Highlight к персонажу
    if player.Character then
        highlight.Adornee = player.Character
        box.Adornee = player.Character:FindFirstChild("HumanoidRootPart")
    end
    
    print("✅ " .. player.Name .. " [" .. role .. "]")
end

-- ═══════════════════════════════════════════════════════════════════
-- ОБНОВЛЕНИЕ ESP
-- ═══════════════════════════════════════════════════════════════════
local function UpdateESP()
    if not CONFIG.Enabled then
        for _, data in pairs(espData) do
            if data.Highlight then
                data.Highlight.Enabled = false
            end
            if data.Billboard then
                data.Billboard.Enabled = false
            end
        end
        return
    end
    
    local camPos = Camera.CFrame.Position
    
    for player, data in pairs(espData) do
        if not data.Folder or not data.Folder.Parent then
            espData[player] = nil
            break
        end
        
        -- Проверяем персонажа
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChild("Humanoid")
        
        -- ===== ОБРАБОТКА СМЕРТИ =====
        if not char or not hrp or not humanoid or humanoid.Health <= 0 then
            -- Игрок мёртв: скрываем Highlight, но оставляем биллборд с пометкой
            data.IsDead = true
            if data.Highlight then
                data.Highlight.Enabled = false
            end
            if data.Box then
                data.Box.Visible = false
            end
            if data.Billboard then
                data.Billboard.Enabled = true
                data.Label.Text = "💀 " .. player.Name .. " (МЁРТВ)"
                data.Label.TextColor3 = Color3.fromRGB(150, 150, 150)
            end
            continue
        end
        
        -- ===== ИГРОК ЖИВ =====
        data.IsDead = false
        
        -- Обновляем роль (на случай смены)
        local newRole = GetPlayerRole(player)
        if newRole ~= data.Role then
            data.Role = newRole
            local color = GetRoleColor(newRole)
            data.Highlight.FillColor = color
            data.Label.TextColor3 = color
            data.Label.Text = GetRoleIcon(newRole) .. " " .. player.Name
            data.Box.Color3 = color
        end
        
        -- Привязываем к персонажу
        if data.Highlight then
            data.Highlight.Adornee = char
            data.Highlight.Enabled = true
        end
        
        -- Обновляем бокс
        if data.Box and hrp then
            data.Box.Adornee = hrp
            data.Box.Visible = true
        end
        
        -- ===== РАССТОЯНИЕ =====
        local dist = (hrp.Position - camPos).Magnitude
        local isVisible = dist <= CONFIG.MaxDist
        
        if data.Billboard then
            data.Billboard.Enabled = isVisible
            if isVisible then
                -- Добавляем дистанцию
                if CONFIG.ShowDistance then
                    data.Label.Text = GetRoleIcon(data.Role) .. " " .. player.Name .. " [" .. math.floor(dist) .. "m]"
                else
                    data.Label.Text = GetRoleIcon(data.Role) .. " " .. player.Name
                end
                
                -- Цвет текста по роли
                data.Label.TextColor3 = GetRoleColor(data.Role)
                
                -- Размер текста в зависимости от расстояния
                local size = CONFIG.TextSize
                if dist > 100 then
                    size = size * (1 - (dist - 100) / CONFIG.MaxDist * 0.5)
                end
                data.Label.TextSize = math.max(12, size)
            end
        end
        
        -- ===== ЗДОРОВЬЕ (если низкое - мигаем) =====
        if humanoid and humanoid.Health < 30 then
            data.Highlight.FillColor = Color3.fromRGB(255, 0, 0)
            data.Highlight.OutlineColor = Color3.fromRGB(255, 200, 0)
            data.Highlight.FillTransparency = 0.3 + 0.3 * math.sin(os.clock() * 4)
        else
            data.Highlight.FillColor = GetRoleColor(data.Role)
            data.Highlight.OutlineColor = CONFIG.OutlineColor
            data.Highlight.FillTransparency = 0.6
        end
    end
end

-- ═══════════════════════════════════════════════════════════════════
-- ОБРАБОТЧИК ПЕРСОНАЖА (для новых игроков)
-- ═══════════════════════════════════════════════════════════════════
local function OnCharacterAdded(player, character)
    task.wait(0.3)
    if espData[player] then
        -- Обновляем существующий ESP
        local data = espData[player]
        if data.Highlight then
            data.Highlight.Adornee = character
        end
        if data.Box then
            local hrp = character:FindFirstChild("HumanoidRootPart")
            if hrp then
                data.Box.Adornee = hrp
            end
        end
        data.Character = character
        data.IsDead = false
        -- Обновляем роль
        local role = GetPlayerRole(player)
        data.Role = role
        local color = GetRoleColor(role)
        data.Highlight.FillColor = color
        data.Label.TextColor3 = color
        data.Label.Text = GetRoleIcon(role) .. " " .. player.Name
        data.Box.Color3 = color
    else
        -- Создаём заново
        CreateESP(player)
    end
end

