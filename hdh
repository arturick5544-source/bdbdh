-- ЗАПУСК
-- ═══════════════════════════════════════════════════════════════════
local function Init()
    print("═══════════════════════════════════════════════")
    print("🔪 MM2 ESP ULTRA ЗАПУСК...")
    print("═══════════════════════════════════════════════")
    
    -- Очистка
    if CoreGui:FindFirstChild("MM2_ESP_DELTA_ULTRA") then
        CoreGui:FindFirstChild("MM2_ESP_DELTA_ULTRA"):Destroy()
    end
    if CoreGui:FindFirstChild("MM2_Menu_ULTRA") then
        CoreGui:FindFirstChild("MM2_Menu_ULTRA"):Destroy()
    end
    
    ESPFolder = Instance.new("Folder")
    ESPFolder.Name = "MM2_ESP_DELTA_ULTRA"
    ESPFolder.Parent = CoreGui
    
    -- Создаём ESP для всех
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            task.wait(0.05)
            CreateESP(player)
        end
    end
    
    -- Меню
    CreateMenu()
    
    -- Обновление
    RunService.Heartbeat:Connect(function()
        pcall(UpdateESP)
    end)
    
    -- Новые игроки
    Players.PlayerAdded:Connect(function(player)
        if player ~= LocalPlayer then
            task.wait(0.5)
            CreateESP(player)
            player.CharacterAdded:Connect(function()
                task.wait(0.5)
                if espData[player] then
                    local role = GetPlayerRole(player)
                    local color = GetRoleColor(role)
                    espData[player].Role = role
                    espData[player].RoleBar.BackgroundColor3 = color
                    espData[player].IconLabel.Text = GetRoleIcon(role)
                    espData[player].IconLabel.TextColor3 = color
                    espData[player].NameLabel.TextColor3 = color
                    espData[player].IsDead = false
                end
            end)
        end
    end)
    
    -- Выход
    Players.PlayerRemoving:Connect(function(player)
        if espData[player] then
            if espData[player].Gui then
                espData[player].Gui:Destroy()
            end
            espData[player] = nil
        end
    end)
    
    print("═══════════════════════════════════════════════")
    print("✅ MM2 ESP ULTRA УСПЕШНО ЗАПУЩЕН!")
    print("📌 F1 - Меню (с анимацией)")
    print("📌 Роли: 🔴 Убийца  🔵 Шериф  🟢 Мирный")
    print("📌 Белая обводка у всех игроков")
    print("📌 ЦВЕТА СООТВЕТСТВУЮТ РОЛЯМ!")
    print("📌 Отключить: _G.STOP_MM2 = true")
    print("═══════════════════════════════════════════════")
end

-- Запуск
pcall(Init)

-- Отключение
RunService.Heartbeat:Connect(function()
    if _G.STOP_MM2 then
        if CoreGui:FindFirstChild("MM2_ESP_DELTA_ULTRA") then
            CoreGui:FindFirstChild("MM2_ESP_DELTA_ULTRA"):Destroy()
        end
        if CoreGui:FindFirstChild("MM2_Menu_ULTRA") then
            CoreGui:FindFirstChild("MM2_Menu_ULTRA"):Destroy()
        end
        espData = {}
        _G.STOP_MM2 = nil
        print("🔪 MM2 ESP ULTRA ОСТАНОВЛЕН")
    end
end)

