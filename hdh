                frame.Visible = true
                frame.Size = UDim2.new(0, 0, 0, 0)
                frame:TweenSize(UDim2.new(0, 280, 0, 320), "Out", "Elastic", 0.7, true)
            end
        end
    end)
    
    return frame, openBtn
end

