local CONFIG = {
    Enabled = true,
    MaxDist = 500,
    OutlineColor = Color3.fromRGB(255, 255, 255), -- Белая обводка
    FillColor = Color3.fromRGB(0, 255, 200),      -- Цвет заливки
    FillTransparency = 0.7,
    OutlineTransparency = 0.1
}

