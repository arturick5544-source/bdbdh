        Color3.fromRGB(255, 0, 100),
        Color3.fromRGB(0, 200, 255),
        Color3.fromRGB(255, 200, 0),
        Color3.fromRGB(200, 0, 255)
    }
    local colorNames = {"БИРЮЗ", "КРАСНЫЙ", "СИНИЙ", "ЖЕЛТЫЙ", "ФИОЛЕТ"}
    local colorIndex = 1
    colorBtn.MouseButton1Click:Connect(function()
        colorIndex = colorIndex % #colors + 1
        CONFIG.FillColor = colors[colorIndex]
        colorBtn.Text = "🎨 " .. colorNames[colorIndex]
        for _, data in pairs(espData) do
            if data.Highlight then
                data.Highlight.FillColor = CONFIG.FillColor
