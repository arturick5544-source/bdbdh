-- ЗАПУСК
-- ═══════════════════════════════════════════════════════════════════
local function Init()
    print("═══════════════════════════════════════════════")
    print("🔪 MM2 ESP PRO ЗАПУСК...")
    print("═══════════════════════════════════════════════")
    
    -- Очистка старых объектов
    if CoreGui:FindFirstChild("MM2_ESP_PRO") then
        CoreGui:FindFirstChild("MM2_ESP_PRO"):Destroy()
    end
    if CoreGui:FindFirstChild("MM2_Menu_PRO") then
        CoreGui:FindFirstChild("MM2_Menu_PRO"):Destroy()
    end
    
    -- Создаём папку
    ESPFolder = Instance.new("Folder")
    ESPFolder.Name = "MM2_ESP_PRO"
    ESPFolder.Parent = CoreGui
    
    -- Создаём ESP для всех игроков
    local players = Players:GetPlayers()
    for i, player in ipairs(players) do
        if player ~= LocalPlayer then
            task.wait(0.05)
            CreateESP(player)
        end
    end
    
    -- Создаём меню
    CreateMenu()
    
    -- Основной цикл обновления
    RunService.Heartbeat:Connect(function()
        pcall(UpdateESP)
    end)
    
    -- Обработка новых игроков
    Players.PlayerAdded:Connect(function(player)
        task.wait(0.5)
        if player ~= LocalPlayer then
            CreateESP(player)
            -- Подписываемся на появление персонажа
            player.CharacterAdded:Connect(function(char)
                OnCharacterAdded(player, char)
            end)
        end
    end)
    
    -- Обработка выхода игроков
    Players.PlayerRemoving:Connect(function(player)
        if espData[player] then
            if espData[player].Folder then
                espData[player].Folder:Destroy()
            end
            espData[player] = nil
        end
    end)
    
    -- Подписываемся на существующих игроков
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            player.CharacterAdded:Connect(function(char)
                OnCharacterAdded(player, char)
            end)
        end
    end
    
    print("═══════════════════════════════════════════════")
    print("✅ MM2 ESP PRO УСПЕШНО ЗАПУЩЕН!")
    print("📌 F1 - Меню")
    print("📌 Роли: 🔴 Убийца  🔵 Шериф  🟢 Мирный")
    print("📌 ESP остаётся после смерти")
    print("📌 Отключить: _G.STOP_MM2 = true")
    print("═══════════════════════════════════════════════")
end

-- Запуск
local success, err = pcall(Init)
if not success then
    print("❌ Ошибка запуска: " .. tostring(err))
end

-- Отключение
RunService.Heartbeat:Connect(function()
    if _G.STOP_MM2 then
        if CoreGui:FindFirstChild("MM2_ESP_PRO") then
            CoreGui:FindFirstChild("MM2_ESP_PRO"):Destroy()
        end
        if CoreGui:FindFirstChild("MM2_Menu_PRO") then
            CoreGui:FindFirstChild("MM2_Menu_PRO"):Destroy()
        end
        espData = {}
        _G.STOP_MM2 = nil
        print("🔪 MM2 ESP PRO ОСТАНОВЛЕН")
    end
end)

