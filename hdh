-- ФУНКЦИЯ: AIMBOT (Автоматическое наведение)
-- ═══════════════════════════════════════════════════
local function GetPredictedPosition(player, targetPart)
    if not _G.STARS_CONFIG.Aimbot.Prediction then return targetPart.Position end

    local char = player.Character
    if not char then return targetPart.Position end

    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return targetPart.Position end

    local velocity = root.Velocity
    local dist = (targetPart.Position - Camera.CFrame.Position).Magnitude
    local bulletSpeed = 2000
    local time = dist / bulletSpeed

    return targetPart.Position + velocity * time
end

local function IsPointOnScreen(point)
    local screenPos, onScreen = Camera:WorldToScreenPoint(point)
    return onScreen and screenPos.Z > 0
end

local function GetClosestPlayer()
    local localChar = LocalPlayer.Character
    if not localChar or not localChar:FindFirstChild("HumanoidRootPart") then
        return nil
    end

    local bestTarget = nil
    local bestDist = _G.STARS_CONFIG.Aimbot.FOV
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for player, data in pairs(ESPObjects) do
        if player == LocalPlayer then continue end
        
        if _G.STARS_CONFIG.Misc.TeamCheck and _G.STARS_CONFIG.Misc.IgnoreTeammates then
            if player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
                continue
            end
        end

        local char = player.Character
        if not char then continue end

        local aimPart = char:FindFirstChild(_G.STARS_CONFIG.Aimbot.AimPart)
        if not aimPart then
            aimPart = char:FindFirstChild("HumanoidRootPart")
        end
        if not aimPart then continue end

        local pos = GetPredictedPosition(player, aimPart)
        local screenPos, onScreen = Camera:WorldToScreenPoint(pos)
        
        if not onScreen or screenPos.Z <= 0 then continue end

        local dist = (pos - Camera.CFrame.Position).Magnitude
        if dist > _G.STARS_CONFIG.ESP.MaxDistance then continue end

        if _G.STARS_CONFIG.Aimbot.VisibleCheck then
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Blacklist
            params.FilterDescendantsInstances = {localChar, char}
            
            local ray = RaycastParams.new()
            local result = workspace:Raycast(Camera.CFrame.Position, (pos - Camera.CFrame.Position).Unit * dist, params)
            if result and not result.Instance:IsDescendantOf(char) then
                continue
            end
        end

        local offset = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
        if offset < bestDist then
            bestDist = offset
            bestTarget = {
                Player = player,
                Part = aimPart,
                Pos = pos,
                Distance = dist,
                Offset = offset
            }
        end
    end

    return bestTarget
end

local function Aimbot()
    if not _G.STARS_CONFIG.Aimbot.Enabled then return end

    if not UserInputService:IsKeyDown(_G.STARS_CONFIG.Aimbot.KeyBind) then
        return
    end

    local target = GetClosestPlayer()
    if not target then return end

    local currentPos = Camera.CFrame.Position
    local lookAt = target.Pos

    local newCFrame = CFrame.lookAt(currentPos, lookAt)
    local currentCFrame = Camera.CFrame

    local smooth = _G.STARS_CONFIG.Aimbot.Smoothness
    local lerpCFrame = currentCFrame:Lerp(newCFrame, smooth)

    Camera.CFrame = lerpCFrame
end

