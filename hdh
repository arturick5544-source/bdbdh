local function Init()
    print("═══════════════════════════════════════════════")
    print("✨ ULTRA ESP ЗАПУСК...")
    print("═══════════════════════════════════════════════")
    
    if CoreGui:FindFirstChild("UltraESP") then
        CoreGui:FindFirstChild("UltraESP"):Destroy()
    end
    if CoreGui:FindFirstChild("UltraMenu") then
        CoreGui:FindFirstChild("UltraMenu"):Destroy()
    end
    
    strokeObjects = {}
    
    ESPFolder = Instance.new("Folder")
    ESPFolder.Name = "UltraESP"
    ESPFolder.Parent = CoreGui
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            task.wait(0.05)
            CreateHighlight(player)
        end
    end
    
    CreateMenu()
    
    RunService.Heartbeat:Connect(function()
        pcall(UpdateESP)
    end)
    
    Players.PlayerAdded:Connect(function(player)
        if player ~= LocalPlayer then
            player.CharacterAdded:Connect(function()
                task.wait(0.5)
                CreateHighlight(player)
            end)
        end
    end)
    
    Players.PlayerRemoving:Connect(function(player)
        if espData[player] then
            if espData[player].Highlight then
                espData[player].Highlight:Destroy()
            end
            espData[player] = nil
        end
    end)
    
    print("═══════════════════════════════════════════════")
    print("✅ ULTRA ESP УСПЕШНО ЗАПУЩЕН!")
    print("📌 F1 - открыть/закрыть меню")
    print("📌 Вкладки: ESP и MUSIC")
    print("📌 В MUSIC введи ID песни и нажми ВКЛЮЧИТЬ")
    print("📌 ВСЕ ИГРОКИ будут слышать музыку!")
    print("📌 Отключить: _G.STOP_ESP = true")
    print("═══════════════════════════════════════════════")
end

pcall(Init)

RunService.Heartbeat:Connect(function()
    if _G.STOP_ESP then
        if CoreGui:FindFirstChild("UltraESP") then
            CoreGui:FindFirstChild("UltraESP"):Destroy()
        end
        if CoreGui:FindFirstChild("UltraMenu") then
            CoreGui:FindFirstChild("UltraMenu"):Destroy()
        end
        if currentSound then
            currentSound:Stop()
            currentSound:Destroy()
            currentSound = nil
        end
        if soundPart then
            soundPart:Destroy()
            soundPart = nil
        end
        espData = {}
        if rainbowThread then
            rainbowThread = nil
        end
        strokeObjects = {}
        _G.STOP_ESP = nil
        print("✨ ULTRA ESP ОСТАНОВЛЕН")
    end
end)

