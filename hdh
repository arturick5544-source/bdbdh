        CONFIG.MaxDist = distValues[distIndex]
        distBtn.Text = "📏 " .. CONFIG.MaxDist .. "м"
    end)
    
    -- КНОПКА ЦВЕТА
    local colorBtn = CreateStyledButton(settings, 84, "БИРЮЗ", "🎨")
