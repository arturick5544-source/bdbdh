-- ФУНКЦИЯ: ОБНОВЛЕНИЕ ESP
-- ═══════════════════════════════════════════════════
local function UpdateESP()
    if not _G.STARS_CONFIG.ESP.Enabled then
        for _, data in pairs(ESPObjects) do
            if data.Box then
                data.Box.Visible = false
                data.Tracer.Visible = false
            end
        end
        return
    end

    local localChar = LocalPlayer.Character
    if not localChar or not localChar:FindFirstChild("HumanoidRootPart") then return end

    local camPos = Camera.CFrame.Position
    local camLookVector = Camera.CFrame.LookVector

    for player, data in pairs(ESPObjects) do
        if not data.Box or not data.Box.Parent then
            ESPObjects[player] = nil
            break
        end

        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChild("Humanoid")

        if hrp and humanoid and _G.STARS_CONFIG.ESP.Enabled then
            local dist = (hrp.Position - camPos).Magnitude

            if dist <= _G.STARS_CONFIG.ESP.MaxDistance then
                -- Показываем объекты
                data.Box.Visible = true
                data.Box.Adornee = hrp

                -- Динамический размер бокса
                local sizeMultiplier = 1 + (0.3 / (dist/10 + 1))
                local boxSize = Vector3.new(4, 6, 1) * sizeMultiplier
                data.Box.Size = boxSize

                -- Цвет бокса по здоровью
                local healthPercent = humanoid.Health / humanoid.MaxHealth
                local color
                if healthPercent > 0.6 then
                    color = Color3.fromRGB(0, 255, 0)
                elseif healthPercent > 0.3 then
                    color = Color3.fromRGB(255, 255, 0)
                else
                    color = Color3.fromRGB(255, 0, 0)
                end
                data.Box.Color3 = color

                -- Обновление имени
                local displayText = ""
                if _G.STARS_CONFIG.ESP.ShowName then
                    displayText = player.Name
                end
                if _G.STARS_CONFIG.ESP.ShowDistance then
                    displayText = displayText .. " [" .. math.floor(dist) .. "m]"
                end
                data.NameLabel.Text = displayText

                -- Обновление HP
                if _G.STARS_CONFIG.ESP.ShowHealth then
                    data.HPBar.Size = UDim2.new(healthPercent, 0, 1, 0)
                    data.HPText.Text = math.floor(humanoid.Health) .. " / " .. math.floor(humanoid.MaxHealth) .. " HP"
                    data.HPText.Visible = true
                    data.HPBar.Parent.Visible = true

                    -- Цвет HP бар
                    if healthPercent > 0.6 then
                        data.HPBar.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
                    elseif healthPercent > 0.3 then
                        data.HPBar.BackgroundColor3 = Color3.fromRGB(255, 255, 0)
                    else
                        data.HPBar.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
                    end

                    -- Мигание при низком HP
                    if _G.STARS_CONFIG.ESP.HighlightLowHP and healthPercent < (_G.STARS_CONFIG.ESP.HealthThreshold / 100) then
                        data.Box.Transparency = 0.1 + 0.2 * math.sin(os.clock() * 4)
                        data.Box.Size = boxSize * 1.2
                        data.HPBar.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
                    else
                        data.Box.Transparency = _G.STARS_CONFIG.ESP.BoxTransparency
                    end
                else
                    data.HPText.Visible = false
                    data.HPBar.Parent.Visible = false
                end

                -- Armor
                local armor = 0
                if char:FindFirstChild("Humanoid") and char.Humanoid:FindFirstChild("Armor") then
                    armor = char.Humanoid.Armor.Value
                end
                if _G.STARS_CONFIG.ESP.ShowArmor and armor > 0 then
                    armorBar.Size = UDim2.new(math.min(armor / 100, 1), 0, 1, 0)
                    armorBar.Parent.Visible = true
                else
                    armorBar.Parent.Visible = false
                end

                -- Tracers
                if _G.STARS_CONFIG.Tracers.Enabled then
                    data.Tracer.Visible = true
                    local fromPos = _G.STARS_CONFIG.Tracers.FromBottom and 
                                    Vector3.new(camPos.X, camPos.Y - 2, camPos.Z) or 
                                    camPos
                    data.Tracer.From = fromPos
                    data.Tracer.To = hrp.Position
                    data.Tracer.Color3 = _G.STARS_CONFIG.Tracers.Color
                else
                    data.Tracer.Visible = false
                end

                -- Отслеживание смерти
                if humanoid.Health <= 0 and not data.IsDead then
                    data.IsDead = true
                    if _G.STARS_CONFIG.Damage.ShowKills then
                        ShowKillAnnouncement(player)
                    end
                elseif humanoid.Health > 0 then
                    data.IsDead = false
                end

            else
                data.Box.Visible = false
                data.Tracer.Visible = false
            end
        else
            -- Скрываем, но не удаляем (ESP остаётся после смерти)
            data.Box.Visible = false
            data.Tracer.Visible = false
        end
    end
end

