-- ОПРЕДЕЛЕНИЕ РОЛИ (РАСШИРЕННОЕ)
-- ═══════════════════════════════════════════════════════════════════
local function GetPlayerRole(player)
    if not player or player == LocalPlayer then return "Innocent" end
    
    local character = player.Character
    if not character then return "Innocent" end
    
    -- Проверка инструментов
    local tool = player:FindFirstChildOfClass("Tool")
    if tool then
        local toolName = tool.Name:lower()
        if toolName:find("knife") or toolName:find("dagger") or toolName:find("murder") or 
           toolName:find("blade") or toolName:find("scythe") or toolName:find("sword") then
            return "Murderer"
        end
        if toolName:find("gun") or toolName:find("pistol") or toolName:find("sheriff") or 
           toolName:find("revolver") or toolName:find("shotgun") or toolName:find("paintball") then
            return "Sheriff"
        end
    end
    
    -- Проверка шляп
    local hat = character:FindFirstChild("Hat")
    if hat then
        local hatName = hat.Name:lower()
        if hatName:find("knife") or hatName:find("murder") or hatName:find("killer") or hatName:find("mask") then
            return "Murderer"
        end
        if hatName:find("sheriff") or hatName:find("detective") or hatName:find("badge") or hatName:find("gun") then
            return "Sheriff"
        end
    end
    
    -- Проверка аксессуаров
    for _, accessory in pairs(character:GetChildren()) do
        if accessory:IsA("Accessory") then
            local accName = accessory.Name:lower()
            if accName:find("knife") or accName:find("murder") or accName:find("killer") then
                return "Murderer"
            end
            if accName:find("sheriff") or accName:find("detective") or accName:find("badge") or accName:find("gun") then
                return "Sheriff"
            end
        end
    end
    
    -- Проверка имени
    local nameLower = player.Name:lower()
    if nameLower:find("murder") or nameLower:find("killer") or nameLower:find("knife") or nameLower:find("assassin") then
        return "Murderer"
    end
    if nameLower:find("sheriff") or nameLower:find("detective") or nameLower:find("gun") or nameLower:find("cop") then
        return "Sheriff"
    end
    
    return "Innocent"
end

