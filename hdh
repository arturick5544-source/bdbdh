end

-- ═══════════════════════════════════════════════════════════════════
-- ОБНОВЛЕНИЕ ESP (С ФИКСОМ ЦВЕТОВ)
-- ═══════════════════════════════════════════════════════════════════
local function UpdateESP()
    if not CONFIG.Enabled then
        for _, data in pairs(espData) do
            if data.Frame then
                data.Frame.Visible = false
            end
        end
        return
    end
    
    local camPos = Camera.CFrame.Position
    local viewportSize = Camera.ViewportSize
    
    for player, data in pairs(espData) do
        if not data.Gui or not data.Gui.Parent then
            espData[player] = nil
            break
        end
        
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChild("Humanoid")
        
        -- ===== СМЕРТЬ =====
        if not char or not hrp or not humanoid or humanoid.Health <= 0 then
            data.IsDead = true
            data.Frame.Visible = true
            data.NameLabel.Text = "💀 " .. player.Name .. " (МЁРТВ)"
            data.NameLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
            data.RoleBar.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
            data.IconLabel.Text = "💀"
            data.IconLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
            continue
        end
        
        -- ===== ЖИВ =====
        data.IsDead = false
        
        -- ОБНОВЛЯЕМ РОЛЬ (если изменилась)
        local newRole = GetPlayerRole(player)
        local roleColor = GetRoleColor(newRole)
        
        if newRole ~= data.Role then
            data.Role = newRole
            data.RoleBar.BackgroundColor3 = roleColor
            data.IconLabel.Text = GetRoleIcon(newRole)
            data.IconLabel.TextColor3 = roleColor
            data.LastColor = roleColor
        end
        
        -- ===== ПОЗИЦИЯ =====
        local worldPos = hrp.Position + Vector3.new(0, 3, 0)
        local screenPos, onScreen = Camera:WorldToScreenPoint(worldPos)
        
        if not onScreen then
            data.Frame.Visible = false
            continue
        end
        
        local dist = (hrp.Position - camPos).Magnitude
        
        if dist > CONFIG.MaxDist then
            data.Frame.Visible = false
            continue
        end
        
        -- ===== ПОКАЗЫВАЕМ =====
        data.Frame.Visible = true
        data.Frame.Position = UDim2.new(0, screenPos.X - 80, 0, screenPos.Y - 20)
        
        -- ИМЯ
        if CONFIG.ShowNames then
            data.NameLabel.Text = player.Name
            data.NameLabel.TextColor3 = roleColor -- ЦВЕТ ПО РОЛИ!
        end
        
        -- ДИСТАНЦИЯ
        if CONFIG.ShowDistance then
            data.DistLabel.Text = math.floor(dist) .. "m"
            data.DistLabel.Visible = true
        else
            data.DistLabel.Visible = false
        end
        
        -- ШИРИНА ФРЕЙМА
        local textLen = #player.Name
        local width = math.max(140, textLen * 7 + 60)
        if CONFIG.ShowDistance then
            width = width + 50
        end
        data.Frame.Size = UDim2.new(0, width, 0, 40)
        
        -- ===== НИЗКОЕ ЗДОРОВЬЕ =====
        if humanoid and humanoid.Health < 30 then
            data.Frame.BorderColor3 = Color3.fromRGB(255, 0, 0)
            data.Frame.BackgroundTransparency = 0.3 + 0.3 * math.sin(os.clock() * 4)
        else
            data.Frame.BorderColor3 = Color3.fromRGB(255, 255, 255) -- БЕЛАЯ ОБВОДКА
            data.Frame.BackgroundTransparency = 0.6
        end
    end
end

