-- ЗАПУСК
-- ═══════════════════════════════════════════════════════════════════
local function Init()
    print("═══════════════════════════════════════════════")
    print("✨ ULTRA ESP ЗАПУСК...")
    print("═══════════════════════════════════════════════")
    
    -- Очистка
    if CoreGui:FindFirstChild("UltraESP") then
        CoreGui:FindFirstChild("UltraESP"):Destroy()
    end
    if CoreGui:FindFirstChild("UltraMenu") then
        CoreGui:FindFirstChild("UltraMenu"):Destroy()
    end
    
    ESPFolder = Instance.new("Folder")
    ESPFolder.Name = "UltraESP"
    ESPFolder.Parent = CoreGui
    
    -- Создаём для всех
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            task.wait(0.05)
            CreateHighlight(player)
        end
    end
    
    -- Меню
    CreateMenu()
    
    -- Обновление
    RunService.Heartbeat:Connect(function()
        pcall(UpdateESP)
    end)
    
    -- Новые игроки
    Players.PlayerAdded:Connect(function(player)
        if player ~= LocalPlayer then
            player.CharacterAdded:Connect(function()
                task.wait(0.5)
                CreateHighlight(player)
            end)
        end
    end)
    
    -- Выход
    Players.PlayerRemoving:Connect(function(player)
        if espData[player] then
            if espData[player].Highlight then
                espData[player].Highlight:Destroy()
            end
            espData[player] = nil
        end
    end)
    
    print("═══════════════════════════════════════════════")
    print("✅ ULTRA ESP УСПЕШНО ЗАПУЩЕН!")
    print("📌 F1 - открыть/закрыть меню")
    print("📌 Нажми ✕ — меню скроется, появится квадратик")
    print("📌 Нажми квадратик — меню появится")
    print("📌 Скрипт НЕ ВЫКЛЮЧАЕТСЯ при закрытии меню!")
    print("📌 Отключить: _G.STOP_ESP = true")
    print("═══════════════════════════════════════════════")
end

-- Запуск
pcall(Init)

-- Отключение
RunService.Heartbeat:Connect(function()
    if _G.STOP_ESP then
        if CoreGui:FindFirstChild("UltraESP") then
            CoreGui:FindFirstChild("UltraESP"):Destroy()
        end
        if CoreGui:FindFirstChild("UltraMenu") then
            CoreGui:FindFirstChild("UltraMenu"):Destroy()
        end
        espData = {}
        _G.STOP_ESP = nil
        print("✨ ULTRA ESP ОСТАНОВЛЕН")
    end
end)

